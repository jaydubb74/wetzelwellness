# Copy this file to .env and fill in your values

# Anthropic API key — used by the Vite dev proxy to parse meals via Claude Haiku.
# Get yours at https://console.anthropic.com/
VITE_ANTHROPIC_API_KEY=sk-ant-...

# ── Google Tasks (optional) ───────────────────────────────────────────────────
# See src/services/googleTasks.js for full setup instructions.
# 1. Create a project at https://console.cloud.google.com/
# 2. Enable the Google Tasks API
# 3. Create OAuth2 Web credentials
# 4. Add http://localhost:5173 as an authorized JavaScript origin
VITE_GOOGLE_CLIENT_ID=
