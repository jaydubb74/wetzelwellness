# Copy this file to .env and fill in your values

# Anthropic API key — used by the Vite dev proxy to parse meals via Claude Haiku.
# Get yours at https://console.anthropic.com/
VITE_ANTHROPIC_API_KEY=sk-ant-...

# Oura + cross-device sync need no env vars here: the Oura token and sync key
# are entered in the app's Settings tab. In dev, /api/oura and /api/sync are
# proxied to the deployed Cloudflare Pages site (see vite.config.js).
